{
  "name": "deepseek-acp",
  "version": "0.6.0",
  "description": "Editor-facing Agent Client Protocol adapter for DeepSeek Harness",
  "license": "MIT",
  "author": "xintaofei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xintaofei/deepseek-acp.git"
  },
  "homepage": "https://github.com/xintaofei/deepseek-acp#readme",
  "bugs": {
    "url": "https://github.com/xintaofei/deepseek-acp/issues"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "deepseek",
    "deepseek-harness",
    "coding-agent",
    "codeg",
    "zed",
    "editor"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "deepseek-acp": "lib/bin.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('lib/bin.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:encoding": "vitest run --config vitest.encoding.config.ts",
    "test:watch": "vitest",
    "probe": "node scripts/acp-probe.mjs",
    "dump-prompt": "node scripts/dump-prompt.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && node scripts/preflight-publish.mjs && npm run typecheck && npm test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh-agent-instructions": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
